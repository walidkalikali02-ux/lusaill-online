import assert from "node:assert/strict";
import {readFile} from "node:fs/promises";
import {PGlite} from "@electric-sql/pglite";
import {seoTemplate,effectiveStatus,type TaskState} from "../lib/seo/model.ts";
import {inspectHtml,inspectDraft} from "../lib/seo/inspect.ts";
import {makeInventory} from "../lib/seo/inventory-core.ts";
import {articles} from "../lib/content.ts";
const originals=(await readFile('docs/seo-user-task-list.txt','utf8')).split(/\r?\n/).map(v=>v.trim()).filter(Boolean);
assert.equal(originals.length,281);assert.deepEqual(seoTemplate.tasks.map(t=>t.original),originals);assert.equal(new Set(seoTemplate.tasks.map(t=>t.id)).size,281);assert.equal(seoTemplate.tasks.filter(t=>t.scope==='article').length,157);assert.equal(seoTemplate.tasks.filter(t=>t.scope==='site').length,124);
const inventory=makeInventory(articles);assert.equal(inventory.targets.length,articles.length+1);assert.equal(inventory.targets.filter(t=>t.live&&t.scope==='article').length,articles.filter(a=>a.status==='published').length);
const first=inventory.targets.find(t=>t.scope==='article')!;const firstDoc=inventory.documents.get(first.key)!;
const changed=makeInventory(articles,[{...firstDoc,answer:firstDoc.answer+' Updated factual details'}]);assert.notEqual(changed.targets.find(t=>t.key===first.key)!.hash,first.hash);
assert.equal(effectiveStatus({status:'done',contentHash:'old'} as TaskState,'new'),'stale');assert.equal(effectiveStatus(undefined,'new'),'pending');
const good='<html lang="ar" dir="rtl"><head><title>عنوان مفيد لخدمة حكومية مصرية مع خطوات واضحة</title><meta name="description" content="'+('وصف مفيد '.repeat(17))+'"><link rel="canonical" href="https://www.lusaill.online/articles/test"></head><body><main><h1>خدمة حكومية</h1><h2>الخطوات</h2><p>'+('خطوة واضحة '.repeat(80))+'</p><img src="/images/test.webp" width="640" height="320" alt="خطوات الخدمة"><a href="/articles/next">الخطوة التالية</a><script type="application/ld+json">[{"@type":"Article"},{"@type":"BreadcrumbList"}]</script></main></body></html>';
const observed=inspectHtml(good,'https://www.lusaill.online/articles/test',200);assert.equal(observed.checks.find(c=>c.id==='canonical')!.status,'pass');assert.equal(observed.checks.find(c=>c.id==='schema')!.status,'pass');assert.equal(inspectHtml(good.replace('</head>','<meta name="robots" content="noindex"></head>'),'https://www.lusaill.online/articles/test',200).checks.find(c=>c.id==='indexable')!.status,'fail');assert.equal(inspectHtml(good.replace('</main>','<h1>Duplicate</h1></main>'),'https://www.lusaill.online/articles/test',200).checks.find(c=>c.id==='h1')!.status,'fail');assert.equal(inspectDraft(firstDoc).facts.publiclyTested,false);
const db=new PGlite();await db.exec(`create role anon;create role authenticated;create role service_role bypassrls;create schema auth;create table auth.users(id uuid primary key);create function auth.uid() returns uuid language sql stable as $$select nullif(current_setting('request.jwt.claim.sub',true),'')::uuid$$;grant usage on schema auth to authenticated,anon;grant execute on function auth.uid() to authenticated,anon;`);
for(const path of ['database/cms-schema.sql','database/migrations/20261102_content_operations.sql','database/migrations/20261102_content_operations_private_rpc.sql','database/migrations/20261102_content_operations_editor.sql','database/migrations/20261102_content_operations_assigned_briefs.sql','database/migrations/20261102_content_operations_release_gates.sql','database/seo-checklist-schema.sql'])await db.exec(await readFile(path,'utf8'));
for(const task of seoTemplate.tasks)await db.query('insert into public.seo_task_definitions(id,scope,definition) values($1,$2,$3::jsonb)',[task.id,task.scope,JSON.stringify(task)]);
const admin='11111111-1111-4111-8111-111111111111',writer='22222222-2222-4222-8222-222222222222',outsider='33333333-3333-4333-8333-333333333333';
await db.exec(`insert into auth.users values('${admin}'),('${writer}'),('${outsider}');insert into public.cms_admins(user_id) values('${admin}');insert into public.ops_members(user_id,role,display_name) values('${writer}','writer','Writer');`);
async function as(user:string,sql:string,params:unknown[]=[]){await db.exec(`set role authenticated;select set_config('request.jwt.claim.sub','${user}',false)`);try{return await db.query(sql,params);}finally{await db.exec('reset role');}}
await as(admin,'select public.seo_sync($1::jsonb)',[JSON.stringify(inventory.targets)]);
await as(admin,'select public.seo_sync($1::jsonb)',[JSON.stringify(inventory.targets)]);assert.equal((await db.query('select count(*)::int as n from public.seo_targets')).rows[0].n,articles.length+1);
const update='select public.seo_set_task($1,$2,$3::jsonb,$4,$5) as state';
await assert.rejects(as(outsider,update,[first.key,'SEO-001','{}',0,first.hash]),/FORBIDDEN/);
await assert.rejects(as(writer,update,[first.key,'SEO-001','{}',0,first.hash]),/FORBIDDEN/);
await assert.rejects(as(admin,update,[first.key,'SEO-090',JSON.stringify({status:'pending'}),0,first.hash]),/TASK_SCOPE_MISMATCH/);
await assert.rejects(as(admin,update,[first.key,'SEO-001',JSON.stringify({status:'done',note:''}),0,first.hash]),/EVIDENCE_REQUIRED/);
const state=JSON.stringify({status:'done',note:'Verified reader need against the actual source',evidence:'https://sis.gov.eg'});
await as(admin,update,[first.key,'SEO-001',state,0,first.hash]);await assert.rejects(as(admin,update,[first.key,'SEO-001',state,0,first.hash]),/VERSION_CONFLICT/);
await assert.rejects(as(admin,update,[first.key,'SEO-001',state,1,'stale']),/CONTENT_CHANGED/);
await as(admin,'select public.ops_save($1,$2::jsonb,$3)',['content_items',JSON.stringify({data:{title:first.title,kind:'article',publicPath:first.path,ownerId:writer}}),0]);
await as(writer,update,[first.key,'SEO-002',JSON.stringify({status:'working',note:'Collecting evidence'}),0,first.hash]);
await assert.rejects(as(writer,update,[first.key,'SEO-044',state,0,first.hash]),/APPROVAL_FORBIDDEN/);
await assert.rejects(as(writer,update,['site','SEO-090',state,0,'site-template-1']),/FORBIDDEN/);
const run='44444444-4444-4444-8444-444444444444';const report=JSON.stringify({checkedAt:new Date().toISOString(),mode:'live',checks:observed.checks,facts:observed.facts});
await as(admin,'select public.seo_record_run($1,$2,$3,$4::jsonb)',[run,first.key,first.hash,report]);await as(admin,'select public.seo_record_run($1,$2,$3,$4::jsonb)',[run,first.key,first.hash,report]);assert.equal((await db.query('select count(*)::int as n from public.seo_review_runs')).rows[0].n,1);
assert.equal((await db.query('select task_states from public.seo_targets where target_key=$1',[first.key])).rows[0].task_states['SEO-003'],undefined);
await assert.rejects(as(writer,'select public.seo_record_run($1,$2,$3,$4::jsonb)',[run,first.key,first.hash,report]),/FORBIDDEN/);
await assert.rejects(as(admin,'update public.seo_task_activity set action=$1',['tamper']),/permission denied/);await assert.rejects(as(admin,'delete from public.seo_review_runs'),/permission denied/);
assert.equal((await as(outsider,'select count(*)::int as n from public.seo_target_summary')).rows[0].n,0);
await db.exec('set role anon');await assert.rejects(db.query('select * from public.seo_targets'),/permission denied/);await db.exec('reset role');
await db.close();console.log(`PASS: all 281 original tasks retained, ${articles.length} article inventories, 157/124 scopes, source changes, HTML checks, ownership, evidence/approval gates, task concurrency, idempotent audit runs and immutable history`);

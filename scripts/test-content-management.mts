import assert from 'node:assert/strict';
import {mergeManagementInventory,managementRequest,matchesManagementItem,managementSummary,isOverdue,type DocumentMetadata} from '../lib/content-ops/management';
import type {OpsRecord} from '../lib/content-ops/model';
const asOf='2026-11-04T08:00:00Z';
const record:OpsRecord={id:'11111111-1111-4111-8111-111111111111',data:{title:'عنصر متابعة',kind:'article',publicPath:'/articles/live',ownerId:'22222222-2222-4222-8222-222222222222',stage:'editorial',priority:'high',dueAt:'2026-11-04T00:30:00+03:00'},version:1,created_by:'test',created_at:asOf,updated_at:asOf};
const original={title:'مقال منشور',href:'/articles/live',kind:'article',category:'الخدمات',status:'published'};
const draft:DocumentMetadata={id:'33333333-3333-4333-8333-333333333333',slug:'live',title:'عنوان نسخة العمل',status:'draft',updatedAt:asOf};
const result=mergeManagementInventory([original],[draft],[],[record]);
assert.equal(result[0].publicationStatus,'published','A private working revision must not hide a still-live publication');
assert.equal(result[0].workflowStatus,'draft');assert.equal(result[0].record?.id,record.id);
assert.equal(mergeManagementInventory([original],[draft],[{...draft,status:'archived'}],[record])[0].publicationStatus,'archived','An explicit retired publication supersedes the static article');
assert.equal(mergeManagementInventory([],[],[{...draft,status:'published'}],[])[0].publicationStatus,'published','CMS-only publications belong in the inventory');
const filters={query:'',kind:'article',category:'',publication:'',owner:'',priority:'',tracked:'',from:'2026-11-04',to:'2026-11-04'};
assert(matchesManagementItem(result[0],filters),'Dates use Qatar day rather than UTC day');
assert(!matchesManagementItem({...result[0],record:undefined},filters),'An undated item does not pass a date-range filter');
assert.equal(managementSummary(result,[],asOf).attention,1);
assert.equal(managementSummary([{...result[0],record:{...record,data:{...record.data,managementArchived:true}}}],[],asOf).attention,0,'Archived tracking is excluded from active alerts, not publication totals');
assert.equal(managementSummary([{...result[0],record:{...record,data:{...record.data,managementArchived:true}}}],[],asOf).published,1);
assert(isOverdue(record.data.dueAt,asOf));
assert(!managementRequest.safeParse({action:'metadata',id:record.id,expectedVersion:1,ownerId:'',dueAt:'',priority:'normal',blockedReason:'',notes:'',archived:false,body:'article text'}).success,'Management endpoint must reject content-writing fields');
assert(!managementRequest.safeParse({action:'generate',topic:'anything'}).success);
assert(!managementRequest.safeParse({action:'track',href:'//external.example/private'}).success);
assert(!managementRequest.safeParse({action:'track',href:'/articles/../admin'}).success);
console.log('PASS: real publication vs draft revision, retirement/CMS-only inventory, Qatar date boundaries, archived follow-up totals, management-only payload and path rejection');

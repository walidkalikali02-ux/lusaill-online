import assert from "node:assert/strict";
import {readFile} from "node:fs/promises";
import {createHash} from "node:crypto";
import {PGlite} from "@electric-sql/pglite";
import {publicHeatmapPath,deviceFor,snapshotSchema,aggregateViews} from "../lib/heatmap/model.ts";
import {signGrant,verifyGrant} from "../lib/heatmap/token.ts";
const key="isolated-test-key-not-a-deployment-secret";
assert(publicHeatmapPath("/articles/example"));assert(publicHeatmapPath("/courses/learn-driving/lesson"));
for(const path of ["/admin","/api/cms","/contact","/search?q=secret","/articles/a?token=secret","/articles/a#value","//evil.test","/articles/../admin","/articles/%2fadmin"])assert(!publicHeatmapPath(path),path);
assert.equal(deviceFor(390),"mobile");assert.equal(deviceFor(820),"tablet");assert.equal(deviceFor(1280),"desktop");
const token=signGrant({path:"/articles/example",width:390,version:"abc123-layout123",test:false},key,1000000);
assert.equal(verifyGrant(token,key,1000000)?.test,false);assert.equal(verifyGrant(token+"x",key,1000000),null);assert.equal(verifyGrant(token,"bad-key",1000000),null);assert.equal(verifyGrant(token,key,3000000),null);
const snapshot={sequence:1,height:4000,viewportHeight:800,scroll:60,seconds:12,clicks:[{x:20,y:40,n:3}],attention:[12,...Array(19).fill(0)]};assert(snapshotSchema.safeParse(snapshot).success);assert(!snapshotSchema.safeParse({...snapshot,formValue:"private"}).success);assert(!snapshotSchema.safeParse({...snapshot,clicks:[{x:90,y:0,n:1}]}).success);assert(!snapshotSchema.safeParse({...snapshot,attention:Array(20).fill(12)}).success);assert(!snapshotSchema.safeParse({...snapshot,clicks:[...snapshot.clicks,...snapshot.clicks]}).success);
const aggregate=aggregateViews([{...snapshot,width:390},{...snapshot,width:390,scroll:20}]);assert.equal(aggregate.views,2);assert.equal(aggregate.clickCount,6);assert.equal(aggregate.reaches[5],1);assert.equal(aggregate.attention[0],24);
const clientSource=await readFile("lib/heatmap/client.ts","utf8");assert(!/textContent|innerHTML|\.value\b|document\.cookie|localStorage/.test(clientSource));assert(clientSource.includes('form,[contenteditable'));assert(clientSource.includes('data-heatmap-mask'));
const db=new PGlite();await db.exec(`create role anon;create role authenticated;create schema auth;create function auth.uid() returns uuid language sql stable as $$select nullif(current_setting('request.jwt.claim.sub',true),'')::uuid$$;create table public.cms_admins(user_id uuid primary key);grant usage on schema auth to anon,authenticated;grant execute on function auth.uid() to anon,authenticated;`);
await db.exec(await readFile("database/heatmap-schema.sql","utf8"));
const hash=createHash("sha256").update(key).digest("hex");await db.query("update heatmap_private.settings set key_hashes=array[$1]",[hash]);
const admin="11111111-1111-4111-8111-111111111111",outsider="22222222-2222-4222-8222-222222222222";await db.query("insert into cms_admins values($1)",[admin]);
async function as(role:string,user:string|null,sql:string,params:unknown[]=[]){await db.exec(`set role ${role};select set_config('request.jwt.claim.sub','${user??""}',false)`);try{return await db.query(sql,params);}finally{await db.exec("reset role");}}
const today=new Date().toISOString().slice(0,10),filters={from:today,to:today,path:"/articles/example",device:"all",version:"",width:"",test:false};
await assert.rejects(as("anon",null,"select * from heatmap_private.views"),/permission denied/);
await assert.rejects(as("authenticated",outsider,"select public.heatmap_report($1::jsonb)",[JSON.stringify(filters)]),/FORBIDDEN/);
await assert.rejects(as("authenticated",outsider,"select public.heatmap_configure($1::jsonb)",['{"enabled":true,"dailyCap":100}']),/FORBIDDEN/);
const view={...snapshot,id:"33333333-3333-4333-8333-333333333333",path:"/articles/example",version:"abc123-layout123",width:390,test:false};
const ingest=(payload:unknown,appKey=key)=>as("anon",null,"select public.heatmap_accept($1,$2::jsonb) as result",[appKey,JSON.stringify(payload)]);
await assert.rejects(ingest(view,"wrong-key"),/FORBIDDEN/);assert.equal((await ingest(view)).rows[0].result.reason,"paused");
await as("authenticated",admin,"select public.heatmap_configure($1::jsonb)",['{"enabled":true,"dailyCap":100}']);
assert.equal((await ingest(view)).rows[0].result.accepted,true);assert.equal((await ingest(view)).rows[0].result.replayed,true);
await ingest({...view,sequence:2,seconds:20,clicks:[{x:20,y:40,n:5}],attention:[20,...Array(19).fill(0)]});await ingest(view);
await assert.rejects(ingest({...view,sequence:3,version:"different"}),/INVALID_DATA/);await assert.rejects(ingest({...view,sequence:3,seconds:1}),/INVALID_DATA/);
await assert.rejects(ingest({...view,id:"44444444-4444-4444-8444-444444444444",path:"/admin"}),/INVALID_DATA/);
await ingest({...view,id:"55555555-5555-4555-8555-555555555555",test:true});
const report=(input:unknown)=>as("authenticated",admin,"select public.heatmap_report($1::jsonb) as report",[JSON.stringify(input)]);
const r=(await report(filters)).rows[0].report;assert.equal(r.totals.views,1);assert.equal(r.selected.clicks[0].n,5);assert.equal(r.selected.reaches[10],1);assert.equal(r.selected.attention[0],20);assert.equal(r.selected.width,390);
assert.equal((await report({...filters,test:true})).rows[0].report.totals.views,1);assert.equal((await report({...filters,device:"desktop"})).rows[0].report.totals.views,0);
await assert.rejects(report({...filters,from:"2020-01-01"}),/INVALID_DATA/);
await db.exec("update heatmap_private.budgets set views=100 where day=current_date");assert.equal((await ingest({...view,id:"66666666-6666-4666-8666-666666666666"})).rows[0].result.reason,"daily_cap");
await db.exec("update heatmap_private.views set created_at=now()-interval '15 days'");await as("anon",null,"select public.heatmap_purge($1)",[key]);assert.equal((await db.query("select count(*)::int as n from heatmap_private.views")).rows[0].n,0);
await db.close();console.log("PASS: signed grants, sensitive-path and payload rejection, geometry-only collection, private data/RPC authorization, replay-safe cumulative updates, test isolation, device filters, daily cap and retention cleanup");

# Copy the Measurement ID from your GA4 web data stream. No tracking is sent without it.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Domain-property Search Console verification uses DNS TXT, not a page meta tag.

# Dedicated Lusaill CMS project; never point at an unrelated database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; required only for the protected scheduled-publishing endpoint.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Server-only heatmap ingestion/signing key. Never prefix with NEXT_PUBLIC_.
HEATMAP_INGEST_KEY=

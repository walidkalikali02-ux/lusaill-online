    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
